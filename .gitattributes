# Keep CAD exchange files and generated render/topology assets out of normal git object history.
assets/** filter=lfs diff=lfs merge=lfs -text
# Keep spec markdown in normal git so reviews and diffs stay readable.
assets/**/*.md !filter !diff !merge text
*.step filter=lfs diff=lfs merge=lfs -text
*.stp filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.3mf filter=lfs diff=lfs merge=lfs -text
*.dxf filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.ply filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/public/hero/**/*.glb !filter !diff !merge -text
.*.step.glb filter=lfs diff=lfs merge=lfs -text
.*.stp.glb filter=lfs diff=lfs merge=lfs -text
**/.*.step/**/*.glb filter=lfs diff=lfs merge=lfs -text
**/.*.step/topology.bin filter=lfs diff=lfs merge=lfs -text
**/.*.step/topology.json filter=lfs diff=lfs merge=lfs -text
models/conformance/*.brep filter=lfs diff=lfs merge=lfs -text
# The vendored WASM STEP-import kernel in the cad-viewer skill runtime: one
# static ~50MB blob, re-vendored only on a deliberate kernel pin bump.
skills/cad-viewer/scripts/viewer/node_modules/opencascade.js/dist/opencascade.full.wasm filter=lfs diff=lfs merge=lfs -text
# Tiny plain-text STEP used by the viewer launch smoke's end-to-end WASM
# import (CI checks out without LFS, so this one fixture must be real text).
models/fixtures/wasm-import-smoke.step !filter !diff !merge text
